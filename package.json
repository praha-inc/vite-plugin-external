{
  "name": "@praha/vite-plugin-external",
  "version": "1.2.0",
  "description": "A Vite plugin that automatically excludes Node.js built-in modules and npm dependencies from the bundle",
  "keywords": [
    "javascript",
    "typescript",
    "vite",
    "plugin"
  ],
  "homepage": "https://github.com/praha-inc/vite-plugin-external/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/praha-inc/vite-plugin-external/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praha-inc/vite-plugin-external.git"
  },
  "license": "MIT",
  "author": "PrAha inc.",
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    "require": {
      "types": "./dist/cjs/index.d.ts",
      "default": "./dist/cjs/index.cjs"
    },
    "import": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rslib build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint:code": "oxlint",
    "lint:type": "tsc --noEmit",
    "version": "changeset",
    "version:apply": "changeset version",
    "version:publish": "changeset publish",
    "version:prepublish": "pkg-pr-new publish --pnpm --compact"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@praha/oxlint-config-standard": "1.0.2",
    "@rslib/core": "0.23.2",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "memfs": "4.69.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "pkg-pr-new": "0.0.91",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "vite": ">=6.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "provenance": true
  }
}
